# License Master database / Supabase
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<supabase-region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_ANON_KEY=<publishable-anon-key-for-admin-sign-in>

# Canonical public License API
LICENSE_API_BASE_URL=https://incendiarynetworks.cc/api/license/v1
LICENSE_API_ISSUER=orbitfs-license-master
LICENSE_API_AUDIENCE=orbitfs-runtime

# Browser/admin configuration
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=https://incendiarynetworks.cc,https://www.incendiarynetworks.cc

# Server-to-server credentials. Never expose these to browser/customer code.
MASTER_API_TOKEN=<server-only-master-token>
BILLING_API_TOKEN=<server-only-store-token>
DEPLOYER_API_TOKEN=<server-only-deployer-token>

# Private GitHub source access for release source/commit discovery.
# Use a server-only GitHub token with read access to V1-vercel-base and V1-vercel-engine.
GITHUB_TOKEN=<server-only-github-token>

# Entitlement signing
LICENSE_ENTITLEMENT_PRIVATE_KEY_B64=<base64-encoded-private-key>
LICENSE_ENTITLEMENT_PUBLIC_KEY_B64=<base64-encoded-public-key>

# API limits / runtime
MAX_JSON_BODY_BYTES=1048576
PORT=3000
