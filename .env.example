DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<supabase-region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_ANON_KEY=<publishable-anon-key-for-admin-sign-in>
ADMIN_EMAILS=admin@example.com
MASTER_API_TOKEN=<server-only-master-token>
BILLING_API_TOKEN=<server-only-store-token>
DEPLOYER_API_TOKEN=<server-only-deployer-token>
LICENSE_ENTITLEMENT_PRIVATE_KEY_B64=<base64-encoded-private-key>
LICENSE_ENTITLEMENT_PUBLIC_KEY_B64=<base64-encoded-public-key>
MAX_JSON_BODY_BYTES=1048576
# Optional comma-separated browser origins. Leave empty for same-origin/public API compatibility.
CORS_ORIGINS=
PORT=3000
