# OrbitFS License Master V2 — environment configuration
# Set these in Vercel Project Settings / Environment Variables.

# 1. Public site / API addresses
# SITE_URL is the actual hostname where this License Master is deployed.
SITE_URL=https://incendiarynetworks.cc
# Canonical API base is the same SITE_URL with /api appended.
LICENSE_API_BASE_URL=https://incendiarynetworks.cc/api
# Billing Store public origin.
BILLING_SITE_URL=https://orbitfsstore.vercel.app

# 2. Database / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Service-to-service authentication
MASTER_API_TOKEN=
BILLING_API_TOKEN=
DEPLOYER_API_TOKEN=

# 4. License signing / API identity
LICENSE_ENTITLEMENT_PRIVATE_KEY_B64=
LICENSE_ENTITLEMENT_PUBLIC_KEY_B64=
LICENSE_API_ISSUER=orbitfs-license-master
LICENSE_API_AUDIENCE=orbitfs-runtime

# 5. Administrator access
ADMIN_EMAILS=

# 6. Release source access
GITHUB_TOKEN=
# Fixed authoritative sources:
# Base release: lucaskerim123/V1-vercel-base @ base-release
# Release updates: lucaskerim123/V1-vercel-engine @ release-updates

# 7. HTTP / API behaviour
# Add any separate browser origins that need CORS access; SITE_URL is allowed automatically.
CORS_ORIGINS=
MAX_JSON_BODY_BYTES=1048576
PORT=3000

# IMPORTANT
# - Public/caller-facing API contract is /api/*.
# - LICENSE_API_BASE_URL must point to the same deployment as SITE_URL, with /api appended.
# - BILLING_SITE_URL is the Billing Store origin, not an API base.
# - Do not configure clients to use /api/v1/*.
# - Supabase /auth/v1/* is Supabase's own Auth API and must remain unchanged.
# - Keep service tokens and private signing keys server-side.
