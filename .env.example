# OrbitFS License Master V2 — environment configuration
# Set these in Vercel Project Settings / Environment Variables.

# 1. Public site / API address
# This is the actual hostname currently serving License Master.
# Example: https://incendiarynetworks.cc
SITE_URL=
LICENSE_API_BASE_URL=

# 2. Database / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Service-to-service authentication
MASTER_API_TOKEN=
BILLING_API_TOKEN=
DEPLOYER_API_TOKEN=

# 4. License signing / API identity
LICENSE_ENTITLEMENT_PRIVATE_KEY_B64=
LICENSE_ENTITLEMENT_PUBLIC_KEY_B64=
LICENSE_API_ISSUER=orbitfs-license-master
LICENSE_API_AUDIENCE=orbitfs-runtime

# 5. Administrator access
ADMIN_EMAILS=

# 6. Release source access
GITHUB_TOKEN=

# 7. HTTP / API behaviour
# Set this to the browser origins allowed to call the API.
# Example: https://incendiarynetworks.cc,https://www.incendiarynetworks.cc
CORS_ORIGINS=
MAX_JSON_BODY_BYTES=1048576
PORT=3000

# IMPORTANT
# - Public/caller-facing API contract is /api/*.
# - The public base is derived from SITE_URL at runtime.
# - Do not hardcode the License Master hostname in application code.
# - Do not configure clients to use /api/v1/*.
# - Keep all service tokens and private signing keys server-side.
# - LICENSE_API_BASE_URL should normally be SITE_URL + /api.
