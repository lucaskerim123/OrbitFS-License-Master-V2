# OrbitFS License Master V2 — environment configuration
# Set these in Vercel Project Settings / Environment Variables.

# 1. Database / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Service-to-service authentication
MASTER_API_TOKEN=
BILLING_API_TOKEN=
DEPLOYER_API_TOKEN=

# 3. License signing / API identity
LICENSE_ENTITLEMENT_PRIVATE_KEY_B64=
LICENSE_ENTITLEMENT_PUBLIC_KEY_B64=
LICENSE_API_BASE_URL=https://orbitfs.cc/api
LICENSE_API_ISSUER=orbitfs-license-master
LICENSE_API_AUDIENCE=orbitfs-runtime

# 4. Administrator access
ADMIN_EMAILS=

# 5. Release source access
GITHUB_TOKEN=

# 6. HTTP / API behaviour
CORS_ORIGINS=https://orbitfs.cc,https://www.orbitfs.cc
MAX_JSON_BODY_BYTES=1048576
PORT=3000

# IMPORTANT
# - Public/caller-facing API contract is /api/*.
# - Do not configure clients to use /api/v1/*.
# - Keep all service tokens and private signing keys server-side.
# - LICENSE_API_BASE_URL is the canonical URL clients/connectors should use.
