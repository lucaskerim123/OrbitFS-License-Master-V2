# OrbitFS License Master V2 — environment configuration
# Set these in Vercel Project Settings / Environment Variables.

# 1. Public site / API addresses
# License Master public site. API routes are SITE_URL + /api/...
SITE_URL=https://orbitfs.cc
LICENSE_API_BASE_URL=https://orbitfs.cc/api
# Billing Store public site used for customer/account/store links and browser CORS.
BILLING_SITE_URL=https://orbitfsstore.vercel.app

# 2. Database / Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Service-to-service authentication
MASTER_API_TOKEN=
BILLING_API_TOKEN=
DEPLOYER_API_TOKEN=

# 4. License signing / API identity
LICENSE_ENTITLEMENT_PRIVATE_KEY_B64=
LICENSE_ENTITLEMENT_PUBLIC_KEY_B64=
LICENSE_API_ISSUER=orbitfs-license-master
LICENSE_API_AUDIENCE=orbitfs-runtime

# 5. Administrator access
ADMIN_EMAILS=

# 6. Release source access
GITHUB_TOKEN=
RELEASE_BASE_REPOSITORY=
RELEASE_BASE_BRANCH=
RELEASE_UPDATE_REPOSITORY=
RELEASE_UPDATE_BRANCH=

# 7. HTTP / API behaviour
# Browser origins allowed to call the License Master API.
CORS_ORIGINS=https://orbitfs.cc,https://orbitfsstore.vercel.app
MAX_JSON_BODY_BYTES=1048576
PORT=3000

# IMPORTANT
# - Public/caller-facing API contract is /api/*.
# - API URLs are formed as {SITE_URL}/api/{endpoint}.
# - LICENSE_API_BASE_URL is the canonical API base and normally equals {SITE_URL}/api.
# - BILLING_SITE_URL is the Billing Store origin; it is NOT an API base.
# - Do not hardcode production site hostnames in application code.
# - Do not configure clients to use /api/v1/*.
# - Keep all service tokens and private signing keys server-side.
