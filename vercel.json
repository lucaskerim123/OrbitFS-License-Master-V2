{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/**/*.ts": { "maxDuration": 15, "includeFiles": "web/admin.html" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/admin-ui" },
    { "source": "/admin", "destination": "/api/admin-ui" },
    { "source": "/admin/", "destination": "/api/admin-ui" },
    { "source": "/admin/:path*", "destination": "/api/admin-ui?path=:path*" }
  ]
}
