{
  "version": 2,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/[...path].ts": { "maxDuration": 10, "includeFiles": "web/admin.html" },
    "api/products.ts": { "maxDuration": 10 },
    "api/admin-products-ui.ts": { "maxDuration": 10 },
    "api/admin-control-ui.ts": { "maxDuration": 10, "includeFiles": "web/admin-control.html" }
  },
  "rewrites": [
    { "source": "/admin/products", "destination": "/api/admin-products-ui" },
    { "source": "/v1/products", "destination": "/api/products" },
    { "source": "/v1/products/:path*", "destination": "/api/products" },
    { "source": "/api/v1/products", "destination": "/api/products" },
    { "source": "/api/v1/products/:path*", "destination": "/api/products" },
    { "source": "/admin", "destination": "/api/admin-control-ui" }
  ]
}
