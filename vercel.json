{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/**/*.ts": { "maxDuration": 10, "includeFiles": "web/admin.html" }
  },
  "routes": [
    { "src": "/admin/?$", "dest": "/api/admin" },
    { "src": "/api/admin-control-login/?$", "dest": "/api/admin-control-login" },
    { "src": "/api/admin/license-master/settings/?$", "dest": "/api/admin-license-master-settings" },
    { "src": "/api/admin/license-master/?$", "dest": "/api/admin-license-master" },
    { "src": "/api/admin/licenses/runtime-clients/?$", "dest": "/api/admin-runtime-clients" },
    { "src": "/api/admin/licenses/(?<licenseId>[^/]+)/control/?$", "dest": "/api/admin-license-control?id=$licenseId" },
    { "handle": "filesystem" }
  ]
}
