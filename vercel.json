{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/**/*.ts": { "maxDuration": 10, "includeFiles": "web/admin-control.html" }
  },
  "routes": [
    { "src": "/admin/?$", "dest": "/api/admin-control-ui" },
    { "handle": "filesystem" }
  ]
}
