{
  "version": 2,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/[...path].ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin-ui" }
  ]
}
