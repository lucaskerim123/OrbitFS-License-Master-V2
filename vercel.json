{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/**/*.ts": { "maxDuration": 10, "includeFiles": "web/admin-control.html" }
  },
  "rewrites": [
    { "source": "/api/admin-control-login", "destination": "/api/auth/login" },
    { "source": "/admin", "destination": "/api/admin-control-ui" },
    { "source": "/admin/", "destination": "/api/admin-control-ui" },
    { "source": "/admin/releases", "destination": "/api/admin-release-ui" },
    { "source": "/admin/products", "destination": "/api/admin-products-ui" }
  ]
}
